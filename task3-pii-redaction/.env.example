# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Defaults (left blank / commented) use the bundled mock provider on :9100.

# OpenAI-compatible provider for /v1/chat/completions, e.g. xAI:
LLM_UPSTREAM_BASE_URL=https://api.x.ai/v1
LLM_UPSTREAM_API_KEY=

# Anthropic provider for /v1/messages (optional):
# ANTHROPIC_UPSTREAM_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_UPSTREAM_API_KEY=

# Keys clients must send (Authorization: Bearer <key> or x-api-key: <key>).
# Comma-separated. Leave unset only for local development.
# GATEWAY_API_KEYS=team-key-1,team-key-2

# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8081
