# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Anything left commented uses the bundled mock providers.

# Primary: e.g. xAI (OpenAI-compatible)
PRIMARY_BASE_URL=https://api.x.ai/v1
PRIMARY_API_KEY=
PRIMARY_MODEL=
# Spec default is 3000. Reasoning models often need 3-6s before the first
# token, so raise this if xAI/grok is primary, or most calls will fail over.
# PRIMARY_TIMEOUT_MS=3000

# Secondary (fallback): defaults to the mock on :9202
# SECONDARY_BASE_URL=http://127.0.0.1:9202/v1
# SECONDARY_API_KEY=
# SECONDARY_MODEL=
# SECONDARY_TIMEOUT_MS=10000

# ROUTER_DB_PATH=router.db
# TOKENS_PER_MINUTE=50000
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8082

# Reasoning models (e.g. grok-4.3) bill hidden reasoning tokens that
# max_tokens does not cap; add headroom to every pre-flight estimate:
# EXTRA_RESERVE_TOKENS=500

# Tenant keys (comma-separated). Unset = any bearer key is a tenant.
# ROUTER_API_KEYS=tenant-1,tenant-2

# Token estimate: auto (tiktoken if available, else chars/4) | tiktoken | chars
# TOKENIZER=auto
