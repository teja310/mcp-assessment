# Copy to .env and fill in. .env is git-ignored; never commit secrets.
# GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:9000/mcp

# Opaque tokens: {"<token>": "<role>"}
GATEWAY_TOKENS={"admin-token-123":"admin","viewer-token-456":"viewer"}

# Signed JWTs (use one key type). Role comes from GATEWAY_JWT_ROLE_CLAIM.
# GATEWAY_JWT_SECRET=<at least 32 random bytes>
# GATEWAY_JWT_PUBLIC_KEY_FILE=/path/to/idp-public.pem
# GATEWAY_JWT_ALGORITHMS=RS256
# GATEWAY_JWT_ISSUER=https://idp.example.com
# GATEWAY_JWT_AUDIENCE=mcp-gateway
# GATEWAY_JWT_ROLE_CLAIM=role

# 1 = hide admin_* tools from non-admins' tools/list (default: transparent)
# GATEWAY_FILTER_TOOLS_LIST=0

# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8080
